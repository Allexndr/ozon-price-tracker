# Telegram Bot Token
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_USER_ID=your_user_id_here

# Настройки периодического поиска товаров
SCHEDULED_SEARCH_ENABLED=False
SCHEDULED_SEARCH_INTERVAL_HOURS=6
SCHEDULED_SEARCH_MAX_THREADS=4
SCHEDULED_SEARCH_PRODUCT_FILE=products.txt

# Настройки браузера
HEADLESS_MODE=True  # Запускать браузер в фоновом режиме (True/False)
USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/91.0.4472.124 Safari/537.36
CHROME_EXECUTABLE_PATH=  # Путь к исполняемому файлу Chrome (если нужно)

# Допустимое отклонение цены в процентах
PRICE_TOLERANCE_PERCENT=20

# Proxy Settings (optional)
USE_PROXY=false
PROXY_LIST_URL=https://free-proxy-list.net/
# Alternative proxy sources: 
# https://geonode.com/free-proxy-list
# https://proxyscrape.com

# Parser Settings
MAX_THREADS=4
SEARCH_TIMEOUT=30
MAX_RETRIES=3

# Captcha Service
CAPTCHA_API_KEY=your_captcha_api_key_here
CAPTCHA_SERVICE=next_captcha 